{
  "name": "webmcp-studio",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "bun run --filter @webmcp/studio dev",
    "dev:workers": "bun run --filter @webmcp/studio dev",
    "build": "bun run --filter '@webmcp/*' build",
    "lint": "bun run --filter '@webmcp/*' lint",
    "typecheck": "bun run --filter '@webmcp/*' typecheck",
    "test": "bun run --filter '@webmcp/*' test",
    "verify:migrations": "bun scripts/verify-template-version-constraints.ts",
    "verify:media-promotion-migration": "./scripts/verify-media-asset-local-promotions-migration.sh",
    "verify:media-use-migration": "./scripts/verify-media-asset-use-requests-migration.sh",
    "verify:media-catalog-migration": "./scripts/verify-media-asset-catalog-metadata-migration.sh",
    "verify:media-derivation-migration": "./scripts/verify-media-derivation-migration.sh",
    "verify:media-derivation-repository": "bun scripts/verify-media-derivation-repository.ts",
    "verify:media-derivation": "bun run verify:media-derivation-migration && bun run verify:media-derivation-repository && bun run --filter @webmcp/studio test -- src/server/media-derivations.test.ts",
    "verify:cloudflare:static": "bun scripts/verify-cloudflare-deployment-preflight.ts --static",
    "verify:cloudflare:remote": "bun scripts/verify-cloudflare-deployment-preflight.ts --remote-ready",
    "verify:cloudflare:deployed": "bun scripts/verify-cloudflare-deployment-preflight.ts --post-deploy",
    "capture:cross-browser-media:baseline": "bun scripts/capture-cross-browser-media-production-baseline.ts --read-only",
    "deploy:cloudflare:plan": "bun scripts/deploy-cloudflare-production.ts --plan",
    "deploy:cloudflare:production": "bun scripts/deploy-cloudflare-production.ts --apply",
    "verify:conformance:structure": "bun scripts/verify-render-conformance-structure.ts",
    "capture:conformance": "bun run --filter @webmcp/studio capture:conformance",
    "capture:conformance:resources": "CONFORMANCE_CORPUS=resources bun run --filter @webmcp/studio capture:conformance",
    "capture:conformance:components": "CONFORMANCE_CORPUS=components bun run --filter @webmcp/studio capture:conformance",
    "capture:conformance:component-journey": "CONFORMANCE_CORPUS=component-journey bun run --filter @webmcp/studio capture:conformance",
    "capture:conformance:mask": "CONFORMANCE_CORPUS=mask bun run --filter @webmcp/studio capture:conformance",
    "capture:live-editor": "bun run --filter @webmcp/studio capture:live-editor",
    "verify:conformance:pixels": "bun scripts/compare-render-conformance.ts docs/audits/2026-08-27-editor-production-readiness/render-conformance-pixel-manifest.json",
    "verify:conformance:resource-pixels": "bun scripts/compare-render-conformance.ts docs/audits/2026-08-27-editor-production-readiness/text-design-system-conformance-pixel-manifest.json",
    "verify:conformance:component-pixels": "bun scripts/compare-render-conformance.ts docs/audits/2026-08-27-editor-production-readiness/component-conformance-pixel-manifest.json",
    "verify:conformance:component-journey-pixels": "bun scripts/compare-render-conformance.ts docs/audits/2026-08-27-editor-production-readiness/component-journey-conformance-pixel-manifest.json",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "sharp": "^0.35.2",
    "typescript": "^6",
    "wrangler": "latest"
  },
  "packageManager": "bun@1.2.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
