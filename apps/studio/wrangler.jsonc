{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "webmcp-studio",
  "main": "src/server-entry.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "services": [
    {
      "binding": "RENDERER",
      "service": "webmcp-studio-renderer",
    },
  ],
  "vars": {
    "STUDIO_ACCESS_MODE": "cloudflare_access",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_POLICY_AUD": "",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RENDER_ADMISSION",
        "class_name": "RenderAdmission",
      },
    ],
  },
  "migrations": [
    {
      "tag": "render-admission-v1",
      "new_sqlite_classes": ["RenderAdmission"],
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webmcp-studio",
      "migrations_dir": "../../migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "webmcp-studio-assets",
    },
    {
      "binding": "RENDERS",
      "bucket_name": "webmcp-studio-renders",
    },
  ],
}
