{
  "name": "@webmcp/studio",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite dev --port 3001",
    "build": "vite build",
    "build:worker": "bun run build && wrangler deploy --dry-run --outdir dist/worker-dry-run",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "test": "vitest run --config vitest.config.ts --passWithNoTests",
    "test:e2e": "playwright test --config playwright.config.ts",
    "capture:conformance": "bun scripts/capture-render-conformance.ts",
    "capture:live-editor": "bun scripts/capture-live-editor-matrix.ts",
    "library:previews:generate": "bun scripts/generate-library-template-previews.ts generate",
    "library:previews:verify": "bun scripts/generate-library-template-previews.ts verify",
    "routes:generate": "tsr generate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^3.0.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^2.1.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/react-virtual": "^3.14.10",
    "@tanstack/router-plugin": "latest",
    "@webmcp/document": "workspace:*",
    "@webmcp/editor": "workspace:*",
    "@webmcp/render-view": "workspace:*",
    "@webmcp/ui": "workspace:*",
    "@webmcp/webmcp": "workspace:*",
    "@webmcp/worker-boundary": "workspace:*",
    "fabric": "^7.4.0",
    "jose": "^6.1.3",
    "lucide-react": "^1.34.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@playwright/test": "latest",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "1.167.33",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@napi-rs/canvas": "^1.0.8",
    "@vitejs/plugin-react": "^6",
    "eslint": "^9",
    "fake-indexeddb": "^6.2.5",
    "pdfjs-dist": "^6.2.108",
    "typescript": "^6",
    "vite": "^8",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
