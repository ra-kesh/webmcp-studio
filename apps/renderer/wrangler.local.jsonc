{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "webmcp-studio-renderer",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "observability": {
    "enabled": false,
  },
  "browser": {
    "binding": "BROWSER",
  },
  "r2_buckets": [
    {
      "binding": "RENDERS",
      "bucket_name": "webmcp-studio-renders",
    },
  ],
}
